<resources>
 <style name="Theme.PocketKhata" parent="Theme.Material3.Light.NoActionBar">
  <item name="colorPrimary">@color/green</item><item name="colorOnPrimary">@color/white</item><item name="colorSecondary">@color/gold</item><item name="colorSurface">@color/paper</item><item name="colorOnSurface">@color/ink</item><item name="android:windowBackground">@color/paper</item><item name="android:fontFamily">sans</item><item name="android:statusBarColor">@color/paper</item><item name="android:windowLightStatusBar">true</item><item name="android:navigationBarColor">@color/paper</item><item name="android:windowLightNavigationBar">true</item><item name="android:colorAccent">@color/green</item><item name="materialButtonStyle">@style/PKButton</item>
