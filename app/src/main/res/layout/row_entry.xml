<?xml version="1.0" ?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" style="@style/PKCard" android:layout_marginHorizontal="20dp" android:layout_marginBottom="10dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardCornerRadius="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="14dp" android:background="@drawable/glass_panel">
        <ImageView android:id="@+id/entryIcon" android:layout_width="42dp" android:layout_height="42dp" android:padding="10dp" android:background="@drawable/badge_bg" android:src="@drawable/ic_wallet" android:contentDescription=""/>
        <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="12dp">
            <TextView style="@style/PKText" android:id="@+id/entryTitle" android:text="Record" android:maxLines="1" android:ellipsize="end" android:fontFamily="sans-serif-medium"/>
            <TextView style="@style/PKMuted" android:id="@+id/entryMeta" android:text="Food · 9 Nov" android:textSize="11sp" android:maxLines="1" android:ellipsize="end"/>
        </LinearLayout>
        <LinearLayout android:layout_height="wrap_content" android:orientation="vertical" android:layout_width="wrap_content" android:gravity="end" android:layout_marginStart="8dp">
            <TextView style="@style/PKText" android:id="@+id/entryAmount" android:text="৳ 0.00" android:layout_width="wrap_content" android:fontFamily="sans-serif-medium"/>
            <TextView style="@style/PKMuted" android:id="@+id/entryType" android:text="Expense" android:layout_width="wrap_content" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
