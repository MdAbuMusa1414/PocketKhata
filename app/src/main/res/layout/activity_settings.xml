<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="60dp" app:title="Settings" app:titleTextAppearance="@style/PKToolbarTitle" app:navigationIcon="@drawable/ic_back"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
            <com.google.android.material.card.MaterialCardView style="@style/PKCard">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView style="@style/PKMuted" android:text="YOUR ACCOUNT" android:textSize="10sp" android:letterSpacing="0.08"/>
                    <TextView style="@style/PKText" android:id="@+id/account" android:text="" android:layout_marginTop="8dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/PKCard" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView style="@style/PKText" android:text="Monthly Budget" android:fontFamily="sans-serif-medium" android:textSize="18sp"/>
                    <TextView style="@style/PKMuted" android:text="Choose how much you want to spend each month." android:layout_marginTop="6dp"/>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/budgetLayout" style="@style/PKField" android:hint="Budget (BDT)">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/budget" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/>
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.switchmaterial.SwitchMaterial android:id="@+id/showSettled" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="60dp" android:text="Show paid-back loans"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/saveSettings" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:text="Save Settings" app:cornerRadius="14dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.card.MaterialCardView style="@style/PKCard" android:layout_marginTop="16dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
                    <TextView style="@style/PKText" android:text="Your PocketKhata" android:fontFamily="sans-serif-medium" android:textSize="18sp"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/shareSummary" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:text="Share Summary" app:cornerRadius="14dp" style="@style/Widget.Material3.Button.OutlinedButton"/>
                    <com.google.android.material.button.MaterialButton android:id="@+id/github" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:text="Project on GitHub" app:cornerRadius="14dp" style="@style/Widget.Material3.Button.TextButton"/>
                    <TextView style="@style/PKMuted" android:text="PocketKhata · version 1.2" android:gravity="center" android:textSize="12sp" android:layout_marginTop="12dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <com.google.android.material.button.MaterialButton android:id="@+id/logout" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:layout_marginTop="10dp" android:text="Log Out" app:cornerRadius="14dp" style="@style/Widget.Material3.Button.TextButton" android:textColor="@color/red"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="80dp" android:background="@color/white" app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled" app:itemHorizontalTranslationEnabled="false" app:itemIconSize="24dp" app:itemPaddingTop="8dp" app:itemPaddingBottom="8dp" app:itemTextAppearanceActive="@style/PKNavigationLabel" app:itemTextAppearanceInactive="@style/PKNavigationLabel" app:itemIconTint="@color/nav_items" app:itemTextColor="@color/nav_items" app:itemActiveIndicatorStyle="@style/PKNavIndicator"/>
</LinearLayout>
