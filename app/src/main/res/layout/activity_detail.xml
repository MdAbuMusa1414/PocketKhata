<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp" app:title="Inside your khata" app:titleTextColor="@color/ink" app:navigationIcon="@drawable/ic_back"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView style="@style/PKMuted" android:id="@+id/typeLabel" android:text="EXPENSE" android:letterSpacing="0.12" android:textSize="12sp"/>
            <TextView style="@style/PKTitle" android:id="@+id/detailAmount" android:text="৳ 0.00" android:textSize="42sp" android:layout_marginTop="10dp"/>
            <TextView style="@style/PKTitle" android:id="@+id/detailTitle" android:text="Entry title" android:textSize="25sp" android:layout_marginTop="12dp"/>
            <TextView style="@style/PKMuted" android:id="@+id/detailMeta" android:text="Date · category" android:layout_marginTop="8dp"/>
            <TextView style="@style/PKText" android:id="@+id/detailStatus" android:text="" android:layout_marginTop="18dp" android:textColor="@color/green"/>
            <TextView style="@style/PKText" android:id="@+id/detailPerson" android:text="" android:layout_marginTop="18dp"/>
            <TextView style="@style/PKMuted" android:id="@+id/detailNote" android:text="" android:layout_marginTop="12dp"/>
            <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="260dp" android:layout_marginTop="20dp" android:scaleType="centerInside" android:contentDescription="Saved receipt or reference photo" android:visibility="gone"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/call" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Call contact" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/share" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Share entry" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/settle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Mark as settled"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/edit" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Edit entry" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/delete" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Delete entry" style="@style/Widget.Material3.Button.OutlinedButton"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
