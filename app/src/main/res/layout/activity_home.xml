<?xml version="1.0" ?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/paper">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="76dp" android:gravity="center_vertical" android:paddingHorizontal="20dp">
            <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/profileEntry" android:layout_width="0dp" android:layout_height="72dp" android:paddingHorizontal="0dp" android:gravity="center_vertical" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" android:contentDescription="Open My Profile" android:layout_weight="1">
                <com.google.android.material.imageview.ShapeableImageView android:id="@+id/homeAvatar" android:layout_width="42dp" android:layout_height="42dp" android:padding="8dp" android:src="@drawable/ic_person" android:background="@drawable/avatar_surface" android:contentDescription="Your profile photo" app:shapeAppearanceOverlay="@style/PKAvatarCircle" app:strokeColor="@color/on_brand" app:strokeWidth="1.5dp"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
                    <TextView style="@style/PKText" android:text="My Profile" android:fontFamily="sans-serif-medium" android:textSize="14sp"/>
                </LinearLayout>
            </LinearLayout>
            <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton android:id="@+id/add" android:layout_width="wrap_content" android:layout_height="48dp" android:text="Add Record" app:icon="@drawable/ic_add" app:backgroundTint="@color/brand" android:textColor="@color/on_brand" app:iconTint="@color/on_brand" app:strokeColor="@color/brand_deep" app:strokeWidth="1dp" app:cornerRadius="28dp" android:layout_marginStart="12dp" android:textSize="13sp" android:paddingHorizontal="16dp" app:iconSize="18dp" android:elevation="0dp"/>
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:clipToPadding="false" android:paddingBottom="20dp"/>
        <FrameLayout android:layout_width="match_parent" android:layout_height="92dp" android:background="@color/paper">
            <com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/navigation" android:layout_width="match_parent" android:layout_height="76dp" android:background="@drawable/nav_glass" app:menu="@menu/bottom_nav" app:labelVisibilityMode="labeled" app:itemHorizontalTranslationEnabled="false" app:itemIconSize="22dp" app:itemPaddingTop="8dp" app:itemPaddingBottom="6dp" app:itemTextAppearanceActive="@style/PKNavigationLabel" app:itemTextAppearanceInactive="@style/PKNavigationLabel" app:itemIconTint="@color/nav_icons" app:itemTextColor="@color/nav_items" app:itemActiveIndicatorStyle="@style/PKNavIndicator" android:layout_gravity="center" android:layout_marginHorizontal="20dp" android:elevation="3dp"/>
        </FrameLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
