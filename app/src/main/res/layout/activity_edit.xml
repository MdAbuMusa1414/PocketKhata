<?xml version="1.0" ?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/paper">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="64dp" app:title="New entry" app:titleTextColor="@color/ink" app:navigationIcon="@drawable/ic_back"/>
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="24dp">
            <TextView style="@style/PKTitle" android:text="Make every taka count." android:textSize="25sp"/>
            <TextView style="@style/PKMuted" android:text="A quick note today. A clearer picture tomorrow." android:layout_marginTop="8dp"/>
            <TextView style="@style/PKText" android:text="Entry type" android:layout_marginTop="20dp"/>
            <RadioGroup android:id="@+id/type" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/type_expense" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Expense" android:textSize="13sp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/type_lent" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Lent" android:textSize="13sp"/>
                <com.google.android.material.radiobutton.MaterialRadioButton android:id="@+id/type_borrowed" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Borrowed" android:textSize="13sp"/>
            </RadioGroup>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/titleLayout" style="@style/PKField" android:hint="What is this for?">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences" android:maxLength="80"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/amountLayout" style="@style/PKField" android:hint="Amount (BDT)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/PKText" android:text="Category" android:layout_marginTop="16dp"/>
            <Spinner android:id="@+id/category" android:layout_width="match_parent" android:layout_height="48dp"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/date" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Choose date" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/personLayout" style="@style/PKField" android:hint="Person / shop name (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/person" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textPersonName" android:maxLength="60"/>
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/phoneLayout" style="@style/PKField" android:hint="Contact number (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/phone" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="phone" android:maxLength="20"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/PKMuted" android:text="Save a contact to call about a payment or repayment. Phone numbers stay in your private khata." android:textSize="12sp" android:layout_marginTop="6dp"/>
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/noteLayout" style="@style/PKField" android:hint="A little note (optional)">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/note" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="textCapSentences|textMultiLine" android:minLines="2" android:maxLength="500"/>
            </com.google.android.material.textfield.TextInputLayout>
            <TextView style="@style/PKText" android:text="Receipt or reference photo" android:layout_marginTop="20dp"/>
            <ImageView android:id="@+id/photo" android:layout_width="match_parent" android:layout_height="180dp" android:scaleType="centerInside" android:src="@drawable/ic_receipt" android:background="@color/mint" android:contentDescription="Receipt preview" android:layout_marginTop="12dp"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/camera" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Take photo" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/gallery" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Choose from gallery" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/removePhoto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Remove photo" style="@style/Widget.Material3.Button.OutlinedButton"/>
            <TextView style="@style/PKMuted" android:text="Receipts are resized before saving to keep your khata light." android:textSize="12sp" android:layout_marginTop="8dp"/>
            <com.google.android.material.button.MaterialButton app:cornerRadius="16dp" android:id="@+id/save" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Save entry"/>
            <ProgressBar android:id="@+id/progress" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone"/>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
